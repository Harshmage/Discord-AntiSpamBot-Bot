# Bot token from https://discord.com/developers/applications -> Bot
DISCORD_TOKEN=

# Right-click the server / channel / role with Developer Mode on -> Copy ID
GUILD_ID=
MOD_CHANNEL_ID=
# Optional: members with this role may use /whitelist and /signals
# (members with Kick Members or Administrator can always use them)
MOD_ROLE_ID=

# Keep true until the mod channel shows correct "would kick" reports
DRY_RUN=true

# How often to re-scan the whole server for flagged members
SWEEP_MINUTES=5
# Seconds to wait after a join before checking signals (the search index lags)
JOIN_CHECK_DELAY=5
# Message history deleted when banning a rejoiner (max 604800 = 7 days)
BAN_DELETE_SECONDS=86400

DB_PATH=/data/bot.db
